<Application
    x:Class="Pausengong.App.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:conv="using:Pausengong.App.Converters">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>

            <conv:TestModeToBrushConverter x:Key="TestModeToBrushConverter" />
            <conv:TestModeToTextConverter x:Key="TestModeToTextConverter" />
            <conv:InverseBoolConverter x:Key="InverseBoolConverter" />

            <!-- Always-on main-page status strip (next gong / current host) — same brand orange
                 as the test-mode-active color, but fixed since it no longer reflects test mode. -->
            <SolidColorBrush x:Key="StatusBannerBrush" Color="#D97706" />

            <!-- Settings "Gefahrenzone" box (test mode + test gong) — same red as test-mode-off. -->
            <SolidColorBrush x:Key="DangerZoneBorderBrush" Color="#B91C1C" />
            <SolidColorBrush x:Key="DangerZoneBackgroundBrush" Color="#1AB91C1C" />

            <!-- Default ListViewItem selection brushes are near-black and unreadable on our
                 dark background — override with a translucent version of the brand orange. -->
            <SolidColorBrush x:Key="ListViewItemBackgroundSelected" Color="#4DD97706" />
            <SolidColorBrush x:Key="ListViewItemBackgroundSelectedPointerOver" Color="#73D97706" />
            <SolidColorBrush x:Key="ListViewItemBackgroundSelectedPressed" Color="#99D97706" />

            <!-- Room floor-plan visualization (added 2026-10-19, corrected 2026-10-19 after a
                 real screenshot showed the room outline was invisible): same lesson as the
                 ListView override above, applied here too late the first time — the
                 Card*ColorDefaultBrush theme resources are deliberately LOW-contrast (meant for
                 faint card edges), not a legible room outline against this app's black
                 background. Explicit high-contrast colors instead, chosen for a CAD/blueprint
                 "engineering drawing" look (the maintainer's request 2026-10-19) rather than a
                 themed card. -->
            <SolidColorBrush x:Key="RoomOutlineBrush" Color="#E8EAED" />
            <SolidColorBrush x:Key="RoomFillBrush" Color="#14E8EAED" />
            <SolidColorBrush x:Key="RoomDeviceChipBrush" Color="#A8E8EAED" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
