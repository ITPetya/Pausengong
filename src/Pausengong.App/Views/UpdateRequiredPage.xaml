<Page
    x:Class="Pausengong.App.UpdateRequiredPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Padding="24" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="Update erforderlich"
                   FontSize="20"
                   FontWeight="Bold"
                   Foreground="{StaticResource DangerZoneBorderBrush}" />

        <TextBlock Grid.Row="1"
                   x:Name="MessageText"
                   TextWrapping="Wrap"
                   VerticalAlignment="Top" />

        <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
            <Button Content="Update herunterladen" Click="OnDownloadClicked" Style="{StaticResource AccentButtonStyle}" />
            <Button Content="Beenden" Click="OnExitClicked" />
        </StackPanel>
    </Grid>
</Page>
