<Page
    x:Class="Pausengong.App.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:Pausengong.App.ViewModels"
    xmlns:tb="using:H.NotifyIcon">

    <Grid x:Name="RootPanel" Padding="20" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Right-click context menu (Öffnen/Beenden) doesn't work in this build of
             H.NotifyIcon.WinUI — confirmed via logging that MenuFlyout.Opening never fires, a
             routed-event mechanism the package ships disabled. Left-click reopens the window
             (LeftClickCommand, a plain property, unaffected); "Beenden" lives as a button on
             the main window instead (see OnExitClicked). -->
        <tb:TaskbarIcon x:Name="TrayIcon"
                        ToolTipText="Pausengong"
                        LeftClickCommand="{x:Bind ShowFromTrayCommand}" />

        <!-- Always-on status strip: next scheduled gong + which PC currently hosts the broker.
             Test mode is no longer shown here — it moved into the Settings "Gefahrenzone",
             alongside Test-Gong, since it doesn't need to be permanently visible.
             Update-available notice (added 2026-10-19) stacked right below it — kept inside the
             same Grid.Row cell instead of adding a new row, so nothing else's Grid.Row index
             needed to change. Severity (Informational/Warning/Error) follows UpdateUrgency, see
             MainViewModel.ApplyUpdateResult; never shown for a Mandatory update — that case is
             handled before this window even loads, see App.xaml.cs / UpdateRequiredWindow. -->
        <StackPanel Grid.Row="0" Spacing="8">
            <Border Padding="16,10"
                    CornerRadius="6"
                    Background="{StaticResource StatusBannerBrush}">
                <TextBlock FontWeight="Bold"
                           FontSize="16"
                           Foreground="White"
                           Text="{x:Bind ViewModel.StatusBannerText, Mode=OneWay}" />
            </Border>
            <InfoBar IsOpen="{x:Bind ViewModel.UpdateBannerIsOpen, Mode=TwoWay}"
                     Severity="{x:Bind ViewModel.UpdateBannerSeverity, Mode=OneWay}"
                     Title="Update"
                     Message="{x:Bind ViewModel.UpdateBannerMessage, Mode=OneWay}" />
        </StackPanel>

        <!-- Current version, small/grey/unobtrusive, bottom-right of the whole window (the
             maintainer's request 2026-10-19) — overlays every row rather than living in one, so
             it always sits in the window's actual bottom-right corner regardless of how much
             room content there is. Tap re-runs the check (OnVersionTextTapped). -->
        <TextBlock Grid.RowSpan="4"
                   Text="{x:Bind ViewModel.CurrentVersionText, Mode=OneWay}"
                   FontSize="11"
                   Foreground="Gray"
                   HorizontalAlignment="Right"
                   VerticalAlignment="Bottom"
                   Margin="0,0,4,2"
                   Tapped="OnVersionTextTapped" />

        <Grid Grid.Row="1" ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="16">
                <Image x:Name="LogoImage" Width="40" Height="40" />
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Pausengong" FontSize="22" FontWeight="SemiBold" />
                    <TextBlock Text="{x:Bind ViewModel.NextGongTargetText, Mode=OneWay}" Opacity="0.75" />
                </StackPanel>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                <Button VerticalAlignment="Center" Content="Einstellungen" Click="OnSettingsClicked" />
                <Button VerticalAlignment="Center" Content="Beenden" Click="OnExitClicked" />
            </StackPanel>
        </Grid>

        <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="8">
            <TextBox x:Name="NewRoomNameBox" Width="220" PlaceholderText="Neuer Raumname" />
            <Button Content="Raum hinzufügen" Click="OnAddRoomClicked" />
        </StackPanel>

        <!-- Room "floor plan" visualization (replaced the plain rectangular card list
             2026-10-19): each room is drawn as one of a fixed set of hand-designed outlines
             (RoomShapeTemplates — rectangle, L-shape, notched corners, outward bumps, ...),
             picked deterministically per room so it keeps the same look across restarts, and
             grows as more devices land in it (RoomViewModel.Size). No separate "unassigned"
             list: every node that isn't in a custom room lives in "Standardraum", the
             always-present first room shape below.

             Drag/drop still targets the room's rectangular bounding box (the GridView below),
             not a pixel-perfect hit test against the drawn polygon outline — the outline is
             visual flavor, not the actual drop-target shape. That's a deliberate, disclosed
             simplification: true per-pixel polygon hit-testing isn't something WinUI3 supports
             out of the box, and this project has no way to visually verify custom hit-testing
             code anyway (no Windows in the tool environment this was written in). -->
        <ScrollViewer Grid.Row="3"
                      HorizontalScrollMode="Enabled"
                      HorizontalScrollBarVisibility="Auto"
                      VerticalScrollMode="Disabled"
                      VerticalScrollBarVisibility="Disabled">
            <ItemsControl ItemsSource="{x:Bind ViewModel.Rooms, Mode=OneWay}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" Spacing="20" VerticalAlignment="Bottom" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:RoomViewModel">
                        <Grid Width="{x:Bind GridWidth, Mode=OneWay}" Height="{x:Bind GridHeight, Mode=OneWay}">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <!-- The room's own outline — purely decorative background, spans both
                                 rows so header and device grid both visually sit "inside" it.
                                 Explicit high-contrast CAD/blueprint-style colors (RoomOutlineBrush/
                                 RoomFillBrush in App.xaml), not themed Card brushes — see the
                                 comment there for why. -->
                            <Polygon Grid.RowSpan="2"
                                     Points="{x:Bind OutlinePoints, Mode=OneWay}"
                                     Fill="{StaticResource RoomFillBrush}"
                                     Stroke="{StaticResource RoomOutlineBrush}"
                                     StrokeThickness="1.5" />

                            <Grid Grid.Row="0" ColumnSpacing="4" Margin="{x:Bind HeaderMargin, Mode=OneWay}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{x:Bind Name, Mode=OneWay}" FontWeight="SemiBold"
                                           FontFamily="Consolas" Foreground="{StaticResource RoomOutlineBrush}"
                                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                <Button Grid.Column="1" Content="✕" Padding="6,2" Tag="{x:Bind}" Click="OnDeleteRoomClicked"
                                        Visibility="{x:Bind DeleteButtonVisibility}" ToolTipService.ToolTip="Raum löschen" />
                            </Grid>

                            <!-- The actual drop target (see the note above the ScrollViewer) — a
                                 GridView so devices auto-wrap into a grid instead of one column,
                                 same drag/drop handlers as the old ListView (GridView shares the
                                 ListViewBase base class, see OnRoomDrop's cast). -->
                            <GridView Grid.Row="1"
                                      ItemsSource="{x:Bind Nodes, Mode=OneWay}"
                                      Margin="{x:Bind DeviceAreaMargin, Mode=OneWay}"
                                      SelectionMode="None"
                                      CanDragItems="True"
                                      AllowDrop="True"
                                      DragItemsStarting="OnNodeDragItemsStarting"
                                      Drop="OnRoomDrop"
                                      DragOver="OnListDragOver"
                                      Tag="{x:Bind}"
                                      Background="Transparent">
                                <GridView.ItemTemplate>
                                    <DataTemplate x:DataType="vm:NodeListItem">
                                        <Border Background="Transparent"
                                                BorderBrush="{StaticResource RoomDeviceChipBrush}"
                                                BorderThickness="1"
                                                CornerRadius="2"
                                                Padding="8,4"
                                                Margin="2">
                                            <TextBlock Text="{x:Bind DisplayLabel, Mode=OneWay}" FontFamily="Consolas"
                                                       Foreground="{StaticResource RoomOutlineBrush}" FontSize="12" />
                                        </Border>
                                    </DataTemplate>
                                </GridView.ItemTemplate>
                            </GridView>
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</Page>
