<Page
    x:Class="Pausengong.App.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:Pausengong.App.ViewModels"
    xmlns:tb="using:H.NotifyIcon">

    <Grid x:Name="RootPanel" Padding="20" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Right-click context menu (Öffnen/Beenden) doesn't work in this build of
             H.NotifyIcon.WinUI — confirmed via logging that MenuFlyout.Opening never fires, a
             routed-event mechanism the package ships disabled. Left-click reopens the window
             (LeftClickCommand, a plain property, unaffected); "Beenden" lives as a button on
             the main window instead (see OnExitClicked). -->
        <tb:TaskbarIcon x:Name="TrayIcon"
                        ToolTipText="Pausengong"
                        LeftClickCommand="{x:Bind ShowFromTrayCommand}" />

        <!-- Always-on status strip: next scheduled gong + which PC currently hosts the broker.
             Test mode is no longer shown here — it moved into the Settings "Gefahrenzone",
             alongside Test-Gong, since it doesn't need to be permanently visible.
             Update-available notice (added 2026-10-19) stacked right below it — kept inside the
             same Grid.Row cell instead of adding a new row, so nothing else's Grid.Row index
             needed to change. Severity (Informational/Warning/Error) follows UpdateUrgency, see
             MainViewModel.ApplyUpdateResult; never shown for a Mandatory update — that case is
             handled before this window even loads, see App.xaml.cs / UpdateRequiredWindow. -->
        <StackPanel Grid.Row="0" Spacing="8">
            <Border Padding="16,10"
                    CornerRadius="6"
                    Background="{StaticResource StatusBannerBrush}">
                <TextBlock FontWeight="Bold"
                           FontSize="16"
                           Foreground="White"
                           Text="{x:Bind ViewModel.StatusBannerText, Mode=OneWay}" />
            </Border>
            <InfoBar IsOpen="{x:Bind ViewModel.UpdateBannerIsOpen, Mode=TwoWay}"
                     Severity="{x:Bind ViewModel.UpdateBannerSeverity, Mode=OneWay}"
                     Title="Update"
                     Message="{x:Bind ViewModel.UpdateBannerMessage, Mode=OneWay}" />
        </StackPanel>

        <!-- Current version, small/grey/unobtrusive, bottom-right of the whole window (the
             maintainer's request 2026-10-19) — overlays every row rather than living in one, so
             it always sits in the window's actual bottom-right corner regardless of how much
             room content there is. Tap re-runs the check (OnVersionTextTapped). -->
        <TextBlock Grid.RowSpan="4"
                   Text="{x:Bind ViewModel.CurrentVersionText, Mode=OneWay}"
                   FontSize="11"
                   Foreground="Gray"
                   HorizontalAlignment="Right"
                   VerticalAlignment="Bottom"
                   Margin="0,0,4,2"
                   Tapped="OnVersionTextTapped" />

        <Grid Grid.Row="1" ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="16">
                <Image x:Name="LogoImage" Width="40" Height="40" />
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Pausengong" FontSize="22" FontWeight="SemiBold" />
                    <TextBlock Text="{x:Bind ViewModel.NextGongTargetText, Mode=OneWay}" Opacity="0.75" />
                </StackPanel>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                <Button VerticalAlignment="Center" Content="Einstellungen" Click="OnSettingsClicked" />
                <Button VerticalAlignment="Center" Content="Beenden" Click="OnExitClicked" />
            </StackPanel>
        </Grid>

        <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="8">
            <TextBox x:Name="NewRoomNameBox" Width="220" PlaceholderText="Neuer Raumname" />
            <Button Content="Raum hinzufügen" Click="OnAddRoomClicked" />
        </StackPanel>

        <!-- Room list (replaced the floor-plan/polygon/spiral visualization 2026-10-19 — "wir
             schaffen die Grundrisse ab, machen Listen nur durch dezente vertikale Linie
             getrennt"): that visualization's Canvas-based absolute positioning failed three
             separate, differently-reasoned fix attempts in a row with the IDENTICAL symptom
             (every room rendering stacked at the same position) — see HANDOFF.md "Room
             visualization" history for exactly what was tried (x:Bind vs {Binding} on the
             attached property, then ItemContainerStyle) and why each one failed. Rather than
             attempt a fourth blind fix, this went back to layout mechanics already proven correct
             by real screenshots: a plain horizontal ItemsControl of rooms (no Canvas, no attached
             properties, no absolute positioning at all) — the exact mechanism the very first
             version of this visualization used, before polygons/shapes were ever introduced, and
             confirmed working then. Each room is a vertical list of workstations, separated from
             its neighbor by a single-pixel vertical line (Rectangle) instead of a drawn wall. No
             separate "unassigned" list: every node that isn't in a custom room lives in
             "Standardraum", the always-present first room below.

             Drag/drop targets the room's ListView (its actual rectangular bounds) — there's no
             polygon outline left to even consider a pixel-perfect hit test against, so that
             earlier disclosed simplification no longer applies at all. -->
        <ScrollViewer Grid.Row="3"
                      HorizontalScrollMode="Enabled"
                      HorizontalScrollBarVisibility="Auto"
                      VerticalScrollMode="Disabled"
                      VerticalScrollBarVisibility="Disabled">
            <ItemsControl ItemsSource="{x:Bind ViewModel.Rooms, Mode=OneWay}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" Spacing="0" VerticalAlignment="Top" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:RoomViewModel">
                        <!-- A Grid, not a horizontal StackPanel, for [room content | divider]:
                             a Rectangle with VerticalAlignment="Stretch" only actually stretches
                             to match a sibling's height inside a Grid row — inside a StackPanel,
                             the Rectangle has no natural height of its own to stretch FROM, so it
                             would just collapse to zero. Grid.ColumnDefinitions sidesteps that. -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Orientation="Vertical" Width="240" Padding="12,0">
                                <!-- Room name — hovering offers rename ("Umbenennen") as well as
                                     delete ("Löschen"), both plain text (the maintainer's request
                                     2026-10-19: "keine Emojis in Texte"). See
                                     RoomViewModel.IsHeaderHovered/IsEditingName and the handlers
                                     in MainPage.xaml.cs. -->
                                <StackPanel Orientation="Horizontal" Spacing="4" Margin="0,0,0,8"
                                            Tag="{x:Bind}"
                                            PointerEntered="OnRoomLabelPointerEntered"
                                            PointerExited="OnRoomLabelPointerExited">
                                    <TextBlock Text="{x:Bind Name, Mode=OneWay}" FontWeight="SemiBold"
                                               FontFamily="Consolas" Foreground="{StaticResource RoomOutlineBrush}"
                                               Visibility="{x:Bind NameTextVisibility, Mode=OneWay}"
                                               TextTrimming="CharacterEllipsis" />
                                    <TextBox Text="{x:Bind Name, Mode=TwoWay}" FontFamily="Consolas" Width="120"
                                             Visibility="{x:Bind NameEditVisibility, Mode=OneWay}"
                                             Tag="{x:Bind}" KeyDown="OnRoomNameTextBoxKeyDown" LostFocus="OnRoomNameEditingLostFocus" />
                                    <Button Content="Umbenennen" Padding="4,0" FontSize="10" Tag="{x:Bind}" Click="OnEditRoomNameClicked"
                                            Visibility="{x:Bind EditButtonVisibility, Mode=OneWay}"
                                            ToolTipService.ToolTip="Raum umbenennen" />
                                    <Button Content="Löschen" Padding="4,0" FontSize="10" Tag="{x:Bind}" Click="OnDeleteRoomClicked"
                                            Visibility="{x:Bind EffectiveDeleteButtonVisibility, Mode=OneWay}"
                                            ToolTipService.ToolTip="Raum löschen" />
                                </StackPanel>

                                <!-- The actual drop target — a vertical list ("Liste", requested
                                     2026-10-19), ItemsSource is DeskSlots not Nodes directly
                                     (rooms always show "mehrere leere Tische", not just the real
                                     occupied ones — see DeskSlot.cs/RoomViewModel.DeskSlots).
                                     ListView, not GridView: GridView shares the ListViewBase base
                                     class with ListView (see OnRoomDrop's cast, unaffected either
                                     way), but a vertical ListView is what "Liste" actually means,
                                     and matches what the very first version of this UI used before
                                     any of the floor-plan work, which is exactly why it's the
                                     proven-safe choice to return to. -->
                                <ListView ItemsSource="{x:Bind DeskSlots, Mode=OneWay}"
                                          SelectionMode="None"
                                          CanDragItems="True"
                                          AllowDrop="True"
                                          DragItemsStarting="OnNodeDragItemsStarting"
                                          Drop="OnRoomDrop"
                                          DragOver="OnListDragOver"
                                          Tag="{x:Bind}"
                                          Background="Transparent">
                                    <ListView.ItemTemplate>
                                        <DataTemplate x:DataType="vm:DeskSlot">
                                            <!-- Workstation, viewed from above (requested
                                                 2026-10-19: "Tisch mit Bildschirm, Tastatur und
                                                 Maus... von oben drauf geblickt"): desk outline,
                                                 monitor (back), keyboard (middle), mouse (side) —
                                                 all plain Rectangle shapes, same reasoning as
                                                 before for avoiding any icon-font glyph dependency
                                                 that could render wrong. -->
                                            <StackPanel Orientation="Horizontal" Spacing="8" Padding="0,2"
                                                        Opacity="{x:Bind VisualOpacity, Mode=OneWay}">
                                                <Grid Width="64" Height="40">
                                                    <Rectangle Stroke="{StaticResource RoomDeviceChipBrush}" StrokeThickness="1" Fill="Transparent" />
                                                    <Rectangle Width="26" Height="6" Fill="{StaticResource RoomDeviceChipBrush}"
                                                               VerticalAlignment="Top" HorizontalAlignment="Center" Margin="0,4,0,0" />
                                                    <Rectangle Width="20" Height="5" Fill="{StaticResource RoomDeviceChipBrush}"
                                                               VerticalAlignment="Center" HorizontalAlignment="Center" Margin="-6,0,0,0" />
                                                    <Rectangle Width="4" Height="4" Fill="{StaticResource RoomDeviceChipBrush}"
                                                               VerticalAlignment="Center" HorizontalAlignment="Center" Margin="18,0,0,0" />
                                                </Grid>
                                                <TextBlock Text="{x:Bind Node.DisplayLabel, Mode=OneWay}" FontFamily="Consolas"
                                                           Foreground="{StaticResource RoomOutlineBrush}" FontSize="12"
                                                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>
                            </StackPanel>

                            <!-- Dezente vertikale Linie (requested 2026-10-19) between rooms —
                                 the only separator now, no drawn walls/doors at all. -->
                            <Rectangle Grid.Column="1" Width="1" Margin="12,8"
                                       Fill="{StaticResource RoomDeviceChipBrush}"
                                       VerticalAlignment="Stretch" />
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</Page>
