<Page
    x:Class="Pausengong.App.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:Pausengong.App.ViewModels"
    xmlns:tb="using:H.NotifyIcon">

    <Grid x:Name="RootPanel" Padding="20" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Right-click context menu (Öffnen/Beenden) doesn't work in this build of
             H.NotifyIcon.WinUI — confirmed via logging that MenuFlyout.Opening never fires, a
             routed-event mechanism the package ships disabled. Left-click reopens the window
             (LeftClickCommand, a plain property, unaffected); "Beenden" lives as a button on
             the main window instead (see OnExitClicked). -->
        <tb:TaskbarIcon x:Name="TrayIcon"
                        ToolTipText="Pausengong"
                        LeftClickCommand="{x:Bind ShowFromTrayCommand}" />

        <!-- Always-on status strip: next scheduled gong + which PC currently hosts the broker.
             Test mode is no longer shown here — it moved into the Settings "Gefahrenzone",
             alongside Test-Gong, since it doesn't need to be permanently visible.
             Update-available notice (added 2026-10-19) stacked right below it — kept inside the
             same Grid.Row cell instead of adding a new row, so nothing else's Grid.Row index
             needed to change. Severity (Informational/Warning/Error) follows UpdateUrgency, see
             MainViewModel.ApplyUpdateResult; never shown for a Mandatory update — that case is
             handled before this window even loads, see App.xaml.cs / UpdateRequiredWindow. -->
        <StackPanel Grid.Row="0" Spacing="8">
            <Border Padding="16,10"
                    CornerRadius="6"
                    Background="{StaticResource StatusBannerBrush}">
                <TextBlock FontWeight="Bold"
                           FontSize="16"
                           Foreground="White"
                           Text="{x:Bind ViewModel.StatusBannerText, Mode=OneWay}" />
            </Border>
            <InfoBar IsOpen="{x:Bind ViewModel.UpdateBannerIsOpen, Mode=TwoWay}"
                     Severity="{x:Bind ViewModel.UpdateBannerSeverity, Mode=OneWay}"
                     Title="Update"
                     Message="{x:Bind ViewModel.UpdateBannerMessage, Mode=OneWay}" />
        </StackPanel>

        <!-- Current version, small/grey/unobtrusive, bottom-right of the whole window (the
             maintainer's request 2026-10-19) — overlays every row rather than living in one, so
             it always sits in the window's actual bottom-right corner regardless of how much
             room content there is. Tap re-runs the check (OnVersionTextTapped). -->
        <TextBlock Grid.RowSpan="4"
                   Text="{x:Bind ViewModel.CurrentVersionText, Mode=OneWay}"
                   FontSize="11"
                   Foreground="Gray"
                   HorizontalAlignment="Right"
                   VerticalAlignment="Bottom"
                   Margin="0,0,4,2"
                   Tapped="OnVersionTextTapped" />

        <Grid Grid.Row="1" ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="16">
                <Image x:Name="LogoImage" Width="40" Height="40" />
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Pausengong" FontSize="22" FontWeight="SemiBold" />
                    <TextBlock Text="{x:Bind ViewModel.NextGongTargetText, Mode=OneWay}" Opacity="0.75" />
                </StackPanel>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                <Button VerticalAlignment="Center" Content="Einstellungen" Click="OnSettingsClicked" />
                <Button VerticalAlignment="Center" Content="Beenden" Click="OnExitClicked" />
            </StackPanel>
        </Grid>

        <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="8">
            <TextBox x:Name="NewRoomNameBox" Width="220" PlaceholderText="Neuer Raumname" />
            <Button Content="Raum hinzufügen" Click="OnAddRoomClicked" />
        </StackPanel>

        <!-- Room "floor plan" visualization (replaced the plain rectangular card list
             2026-10-19, restyled again same day after a real screenshot — see HANDOFF.md "Room
             visualization" entries for the full history): each room is drawn as one of a fixed
             set of hand-designed outlines (RoomShapeTemplates — rectangle, L-shape, notched
             corners, outward bumps, ...), picked deterministically per room so it keeps the same
             look across restarts, and grows as more devices land in it (RoomViewModel.Size). No
             separate "unassigned" list: every node that isn't in a custom room lives in
             "Standardraum", the always-present first room shape below.

             Drag/drop still targets the room's rectangular bounding box (the GridView below),
             not a pixel-perfect hit test against the drawn polygon outline — the outline is
             visual flavor, not the actual drop-target shape. That's a deliberate, disclosed
             simplification: true per-pixel polygon hit-testing isn't something WinUI3 supports
             out of the box, and this project has no way to visually verify custom hit-testing
             code anyway (no Windows in the tool environment this was written in).

             Spiral "building" layout (requested 2026-10-19, confirmed explicitly by the
             maintainer over a simpler row-grid that turned out to look identical to the old
             single-strip layout for a 1-2-room test case — "wie ein zusammenhängendes Gebäude...
             rundrum um Räume erweitert"): ViewModel.RoomLayout (MainViewModel) computes an
             absolute (Left, Top) per room in a spiral around the first one — see
             MainViewModel.SpiralPositions, hand-traced and verified there. That needs a Canvas
             with Canvas.Left/Canvas.Top per item rather than the nested-StackPanel trick used for
             the (abandoned) row-grid — the room content Grid below is unchanged from before,
             just now one level deeper (x:DataType is RoomLayoutEntry, so every former direct
             property reference is now Room.<property>). Two separate Canvas-paneled
             ItemsControls share the one RoomLayout list — doors drawn first (so rooms layer on
             top of them), then rooms — rather than nesting the door inside the room template,
             since a door's position is computed independently of the room's own size (see
             MainViewModel.RebuildRoomLayout) and Canvas.Left/Top only works on a DIRECT child of
             a Canvas.

             Canvas.Left/Canvas.Top are set via ItemContainerStyle, not on the DataTemplate's own
             root element (corrected 2026-10-19, SECOND attempt — the first fix, switching
             {x:Bind} to {Binding} on the inner Grid, did not help; a follow-up screenshot showed
             the exact same stacked-overlap result). The actual root cause: when an ItemsControl
             generates items into a Canvas, each DataTemplate instance is wrapped in an implicit
             ContentPresenter, and THAT — not anything inside the DataTemplate — is the real
             direct child of the Canvas. Canvas.Left/Top only has any effect on a Canvas's direct
             children, so setting it on the inner Grid (one level too deep) was inert regardless
             of which binding syntax was used — both attempts were fixing the wrong symptom. Fix:
             ItemsControl.ItemContainerStyle targeting ContentPresenter, with Setters for
             Canvas.Left/Canvas.Top — this is the standard, long-documented WPF/UWP/WinUI pattern
             for positioning ItemsControl items on a Canvas. Setter.Value only supports plain
             {Binding}, not {x:Bind} (a Style isn't tied to one DataTemplate's compiled-binding
             scope the way x:Bind requires), so that part of the previous fix was right regardless
             — it just needed to be applied in the right place. -->
        <ScrollViewer Grid.Row="3"
                      HorizontalScrollMode="Enabled"
                      HorizontalScrollBarVisibility="Auto"
                      VerticalScrollMode="Enabled"
                      VerticalScrollBarVisibility="Auto">
            <Grid Width="{x:Bind ViewModel.RoomLayoutCanvasWidth, Mode=OneWay}"
                  Height="{x:Bind ViewModel.RoomLayoutCanvasHeight, Mode=OneWay}"
                  HorizontalAlignment="Left"
                  VerticalAlignment="Top">

                <!-- Door connection markers — a plain dashed square, not a directional symbol
                     (see RoomLayoutEntry.cs for why: orientation would need a bound
                     RenderTransform, one more unverifiable thing for a purely decorative detail
                     that doesn't need to be direction-precise). -->
                <ItemsControl ItemsSource="{x:Bind ViewModel.RoomLayout, Mode=OneWay}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <Canvas />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemContainerStyle>
                        <Style TargetType="ContentPresenter">
                            <Setter Property="Canvas.Left" Value="{Binding DoorLeft}" />
                            <Setter Property="Canvas.Top" Value="{Binding DoorTop}" />
                        </Style>
                    </ItemsControl.ItemContainerStyle>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:RoomLayoutEntry">
                            <Grid Width="20" Height="20"
                                  Visibility="{x:Bind DoorVisibility, Mode=OneWay}">
                                <Rectangle Stroke="{StaticResource RoomOutlineBrush}" StrokeThickness="1"
                                           StrokeDashArray="2,2" Fill="Transparent" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <ItemsControl ItemsSource="{x:Bind ViewModel.RoomLayout, Mode=OneWay}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <Canvas />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemContainerStyle>
                        <Style TargetType="ContentPresenter">
                            <Setter Property="Canvas.Left" Value="{Binding Left}" />
                            <Setter Property="Canvas.Top" Value="{Binding Top}" />
                        </Style>
                    </ItemsControl.ItemContainerStyle>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:RoomLayoutEntry">
                            <Grid Width="{x:Bind Room.GridWidth, Mode=OneWay}" Height="{x:Bind Room.GridHeight, Mode=OneWay}">
                                <!-- Walls: a single thick stroke rather than true double-line
                                     architectural walls — offsetting a concave polygon (the
                                     L-shape/notched templates) inward by a wall thickness is a
                                     real computational-geometry problem (self-intersection risk
                                     at concave corners) that can't be verified by rendering here,
                                     so a thicker single line stands in for "wall" instead. -->
                                <Polygon Points="{x:Bind Room.OutlinePoints, Mode=OneWay}"
                                         Fill="{StaticResource RoomFillBrush}"
                                         Stroke="{StaticResource RoomOutlineBrush}"
                                         StrokeThickness="3" />

                                <!-- Two structurally separate zones (requested 2026-10-19: "klarere
                                     Zonen... kein Tisch kollidiert mit der Bezeichnung") instead of
                                     a floating-overlay name, which the desk grid could and did
                                     visually collide with: an Auto row reserved for the name at
                                     the bottom ("auf dem Boden") that the desk GridView above it
                                     can never be laid out into, by ordinary Grid-row partitioning
                                     rather than manual position math. -->
                                <Grid Margin="{x:Bind Room.ContentMargin, Mode=OneWay}">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <!-- The actual drop target — a GridView so devices auto-wrap
                                         into a grid instead of one column, same drag/drop handlers
                                         as the old ListView (GridView shares the ListViewBase base
                                         class, see OnRoomDrop's cast). ItemsSource is DeskSlots,
                                         not Nodes directly (requested 2026-10-19: rooms should
                                         always show "mehrere leere Tische", not just the real
                                         occupied ones) — see DeskSlot.cs/RoomViewModel.DeskSlots.
                                         Each slot renders as a small desk-with-monitor symbol
                                         ("Arbeitsplatz"), dimmed when empty. -->
                                    <GridView Grid.Row="0"
                                              ItemsSource="{x:Bind Room.DeskSlots, Mode=OneWay}"
                                              SelectionMode="None"
                                              CanDragItems="True"
                                              AllowDrop="True"
                                              DragItemsStarting="OnNodeDragItemsStarting"
                                              Drop="OnRoomDrop"
                                              DragOver="OnListDragOver"
                                              Tag="{x:Bind Room}"
                                              Background="Transparent">
                                        <GridView.ItemTemplate>
                                            <DataTemplate x:DataType="vm:DeskSlot">
                                                <StackPanel Spacing="2" Margin="2" Width="56" Opacity="{x:Bind VisualOpacity, Mode=OneWay}">
                                                    <Grid Height="36">
                                                        <Rectangle Stroke="{StaticResource RoomDeviceChipBrush}" StrokeThickness="1" Fill="Transparent" />
                                                        <Rectangle Width="22" Height="5" Fill="{StaticResource RoomDeviceChipBrush}"
                                                                   VerticalAlignment="Top" Margin="0,5,0,0" HorizontalAlignment="Center" />
                                                    </Grid>
                                                    <TextBlock Text="{x:Bind Node.DisplayLabel, Mode=OneWay}" FontFamily="Consolas"
                                                               Foreground="{StaticResource RoomOutlineBrush}" FontSize="10"
                                                               HorizontalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </GridView.ItemTemplate>
                                    </GridView>

                                    <!-- Room name "auf dem Boden" (on the floor) — its own
                                         reserved row now, guaranteed clear of desks. Hovering
                                         offers rename (requested 2026-10-19, "nicht nur löschen")
                                         as well as delete — see RoomViewModel.IsHeaderHovered/
                                         IsEditingName and the handlers in MainPage.xaml.cs. -->
                                    <StackPanel Grid.Row="1" HorizontalAlignment="Center" Margin="0,6,0,0"
                                                Orientation="Horizontal" Spacing="4"
                                                Tag="{x:Bind Room}"
                                                PointerEntered="OnRoomLabelPointerEntered"
                                                PointerExited="OnRoomLabelPointerExited">
                                        <TextBlock Text="{x:Bind Room.Name, Mode=OneWay}" FontWeight="SemiBold"
                                                   FontFamily="Consolas" Foreground="{StaticResource RoomOutlineBrush}"
                                                   Visibility="{x:Bind Room.NameTextVisibility, Mode=OneWay}"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBox Text="{x:Bind Room.Name, Mode=TwoWay}" FontFamily="Consolas" Width="110"
                                                 Visibility="{x:Bind Room.NameEditVisibility, Mode=OneWay}"
                                                 Tag="{x:Bind Room}" KeyDown="OnRoomNameTextBoxKeyDown" LostFocus="OnRoomNameEditingLostFocus" />
                                        <!-- Plain text, no symbol glyphs (the maintainer's request
                                             2026-10-19: "keine Emojis in Texte") — these were
                                             Unicode pictograph characters (pencil/cross), not
                                             actual emoji, but render the same unwanted way. -->
                                        <Button Content="Umbenennen" Padding="4,0" FontSize="10" Tag="{x:Bind Room}" Click="OnEditRoomNameClicked"
                                                Visibility="{x:Bind Room.EditButtonVisibility, Mode=OneWay}"
                                                ToolTipService.ToolTip="Raum umbenennen" />
                                        <Button Content="Löschen" Padding="4,0" FontSize="10" Tag="{x:Bind Room}" Click="OnDeleteRoomClicked"
                                                Visibility="{x:Bind Room.EffectiveDeleteButtonVisibility, Mode=OneWay}"
                                                ToolTipService.ToolTip="Raum löschen" />
                                    </StackPanel>
                                </Grid>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Grid>
        </ScrollViewer>
    </Grid>
</Page>
